{
  "expo": {
    "name": "IrriTrack",
    "slug": "irritrack",
    "version": "1.4",
    "icon": "./assets/icon.png",
    "extra": {
      "projectName": "IrriTrack"
    },
    "notification": {
      "icon": "./assets/notification-icon.png",
      "color": "#1E3E62"
    },
    "ios": {
      "icon": "./assets/icon.png",
      "bundleIdentifier": "org.vensar.irritrack",
      "googleServicesFile": "./GoogleService-Info.plist",
      "deploymentTarget": "15.5",
      "entitlements": {
        "aps-environment": "production"
      },
      "infoPlist": {
        "NSPhotoLibraryAddUsageDescription": "Allow IrriTrack to save submitted checklist photos to your phone gallery.",
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "icon": "./assets/icon.png",
      "package": "com.vensar.irritrack",
      "googleServicesFile": "./android/app/google-services.json",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow IrriTrack to access your photos.",
          "savePhotosPermission": "Allow IrriTrack to save submitted checklist photos to your phone gallery.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow IrriTrack to use Face ID to unlock your session."
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/messaging"
    ]
  }
}
 